{
  "nodes": [
    {
      "id": "code_consolidate",
      "name": "🧮 Consolidar datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        360
      ],
      "parameters": {
        "jsCode": "// Une lo extraído por la IA con los metadatos originales (via pairedItem) y aplica reglas de negocio.\nconst ai = $json.output || {};\nconst orig = $('🧩 Separar adjuntos').item;\nconst j = orig.json;\nlet texto = '';\ntry { texto = ($json.text || '') + ''; } catch (e) {}\n\nconst digits = s => (s || '').toString().replace(/\\D/g, '');\nconst cedula = digits(ai.cedula || j.cedulaNombre || '');\n\nlet nombre = (ai.nombreCompleto || ai.nombre || '').toString().toUpperCase();\nconst nombreNorm = nombre.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\\s+/g, ' ').trim();\n\nconst blob = (texto + ' ' + (j.fileName || '') + ' ' + (ai.entidad || '') + ' ' + (j.subject || '')).toUpperCase();\nconst has = re => re.test(blob);\nlet tipo = (ai.tipoAfiliacion || '').toUpperCase();\nif (!['EPS', 'CCF', 'AFP', 'ARL'].includes(tipo)) {\n  if (has(/\\bARL\\b|RIESGOS LABORALES|POSITIVA|COLMENA/)) tipo = 'ARL';\n  else if (has(/\\bAFP\\b|PENSION|PORVENIR|PROTECCION|COLFONDOS|SKANDIA/)) tipo = 'AFP';\n  else if (has(/\\bCCF\\b|CAJA DE COMPENSACION|COMPENSAR|COLSUBSIDIO|CAFAM|COMFAMA|COMFENALCO|COMFANDI/)) tipo = 'CCF';\n  else tipo = 'EPS';\n}\n\nfunction parseFecha(s) {\n  if (!s) return null; s = s.toString().trim();\n  let m = s.match(/(\\d{4})[-\\/.](\\d{1,2})[-\\/.](\\d{1,2})/);\n  if (m) return `${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;\n  m = s.match(/(\\d{1,2})[-\\/.](\\d{1,2})[-\\/.](\\d{4})/);\n  if (m) return `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;\n  const d = new Date(s); if (!isNaN(d.getTime())) return d.toISOString().slice(0, 10);\n  return null;\n}\n// Prioridad: novedad > ingreso > documento > correo\nconst fecha = parseFecha(ai.fechaNovedad) || parseFecha(ai.fechaIngreso)\n           || parseFecha(ai.fechaDocumento) || parseFecha(j.fechaCorreo) || 'SIN-FECHA';\n\nconst entidad = (ai.entidad || '').toString().toUpperCase().trim();\nconst nombreArchivo = `AFIL ${tipo} ${fecha}.pdf`;\n\nreturn [{\n  json: { ...j, cedula, nombre: nombreNorm, entidad, tipo, fecha, nombreArchivo,\n          datosOk: Boolean(cedula || nombreNorm) },\n  binary: orig.binary,\n}];"
      }
    },
    {
      "id": "http_search_ced",
      "name": "🔍 Drive: buscar carpeta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        360
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ (() => { const c=$json.cedula||''; const n=($json.nombre||'').replace(/'/g,''); const p=[]; if(c)p.push(\"name contains '\"+c+\"'\"); if(n)p.push(\"name contains '\"+n+\"'\"); const cond=p.length?('('+p.join(' or ')+')'):\"name contains 'zzzzzz'\"; return \"mimeType='application/vnd.google-apps.folder' and trashed=false and \"+cond; })() }}"
            },
            {
              "name": "fields",
              "value": "files(id,name,parents)"
            },
            {
              "name": "pageSize",
              "value": "100"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            },
            {
              "name": "includeItemsFromAllDrives",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Drive Ruth"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 4000
    },
    {
      "id": "code_eval",
      "name": "🗂️ Resolver carpeta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        360
      ],
      "parameters": {
        "jsCode": "// Evalúa la respuesta de Google Drive (files API) contra la cédula/nombre del item consolidado.\nconst resp = $json || {};\nconst prev = $('🧮 Consolidar datos').item.json;\nconst ced = prev.cedula || '';\nconst nombre = (prev.nombre || '').toLowerCase();\n\nconst folders = (resp.files || []).filter(f => f && f.id);\n\nconst norm = s => (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();\nlet hits = ced ? folders.filter(f => (f.name || '').replace(/\\D/g, '').includes(ced)) : [];\nlet foundBy = 'cedula';\nif (hits.length === 0 && nombre) {\n  hits = folders.filter(f => norm(f.name).includes(norm(nombre)));\n  foundBy = 'nombre';\n}\n\nlet resolved = 'NONE', folderId = '', folderName = '';\nif (hits.length === 1) { resolved = 'FOUND'; folderId = hits[0].id; folderName = hits[0].name; }\nelse if (hits.length > 1) { resolved = 'MULTIPLE'; folderName = hits.map(h => h.name).join(' | '); }\n\nreturn [{\n  json: { ...prev, resolved, folderId, folderName, folderPath: folderName,\n          foundBy: resolved === 'FOUND' ? foundBy : '', candidatos: folders.length },\n  binary: $('🧮 Consolidar datos').item.binary,\n}];"
      }
    },
    {
      "id": "switch_res",
      "name": "↔️ Resultado",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1380,
        360
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.resolved }}",
                    "rightValue": "FOUND",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "ARCHIVAR"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.resolved }}",
                    "rightValue": "MULTIPLE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "REVISION"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "ERROR"
        }
      }
    },
