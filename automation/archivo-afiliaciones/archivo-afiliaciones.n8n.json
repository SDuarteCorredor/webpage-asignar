    {
      "id": "code_split",
      "name": "🧩 Separar adjuntos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -840,
        360
      ],
      "parameters": {
        "jsCode": "// Un item por cada adjunto (PDF o imagen). Conserva binario y metadatos del correo.\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const binary = item.binary || {};\n  const messageId = j.id || j.messageId || j.Message_ID || '';\n  const subject   = j.subject || j.Subject || (j.headers && j.headers.subject) || '';\n  const date      = j.date || j.Date || j.internalDate || '';\n  let from = '';\n  if (j.from && typeof j.from === 'object') from = j.from.text || (j.from.value && j.from.value[0] && j.from.value[0].address) || '';\n  else from = j.from || j.From || (j.headers && j.headers.from) || '';\n\n  for (const key of Object.keys(binary)) {\n    const b = binary[key];\n    const name = (b.fileName || '').trim();\n    if (!/\\.(pdf|png|jpe?g|tiff?)$/i.test(name)) continue;\n    const esImagen = /\\.(png|jpe?g|tiff?)$/i.test(name);\n    const uid = messageId + '::' + name;\n    out.push({\n      json: {\n        uid, messageId, subject, fechaCorreo: date, remitente: from,\n        fileName: name, esImagen,\n        // extracción determinista preliminar desde el nombre\n        cedulaNombre: (name.match(/\\d{6,}/) || [''])[0],\n      },\n      binary: { data: b },\n    });\n  }\n}\nreturn out;"
      }
    },
