    {
      "id": "code_consolidate",
      "name": "🧮 Consolidar datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        360
      ],
      "parameters": {
        "jsCode": "// Une lo extraído por la IA con los metadatos originales (via pairedItem) y aplica reglas de negocio.\nconst ai = $json.output || {};\nconst orig = $('🧩 Separar adjuntos').item;\nconst j = orig.json;\nlet texto = '';\ntry { texto = ($json.text || '') + ''; } catch (e) {}\n\nconst digits = s => (s || '').toString().replace(/\\D/g, '');\nconst cedula = digits(ai.cedula || j.cedulaNombre || '');\n\nlet nombre = (ai.nombreCompleto || ai.nombre || '').toString().toUpperCase();\nconst nombreNorm = nombre.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\\s+/g, ' ').trim();\n\nconst blob = (texto + ' ' + (j.fileName || '') + ' ' + (ai.entidad || '') + ' ' + (j.subject || '')).toUpperCase();\nconst has = re => re.test(blob);\nlet tipo = (ai.tipoAfiliacion || '').toUpperCase();\nif (!['EPS', 'CCF', 'AFP', 'ARL'].includes(tipo)) {\n  if (has(/\\bARL\\b|RIESGOS LABORALES|POSITIVA|COLMENA/)) tipo = 'ARL';\n  else if (has(/\\bAFP\\b|PENSION|PORVENIR|PROTECCION|COLFONDOS|SKANDIA/)) tipo = 'AFP';\n  else if (has(/\\bCCF\\b|CAJA DE COMPENSACION|COMPENSAR|COLSUBSIDIO|CAFAM|COMFAMA|COMFENALCO|COMFANDI/)) tipo = 'CCF';\n  else tipo = 'EPS';\n}\n\nfunction parseFecha(s) {\n  if (!s) return null; s = s.toString().trim();\n  let m = s.match(/(\\d{4})[-\\/.](\\d{1,2})[-\\/.](\\d{1,2})/);\n  if (m) return `${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;\n  m = s.match(/(\\d{1,2})[-\\/.](\\d{1,2})[-\\/.](\\d{4})/);\n  if (m) return `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;\n  const d = new Date(s); if (!isNaN(d.getTime())) return d.toISOString().slice(0, 10);\n  return null;\n}\n// Prioridad: novedad > ingreso > documento > correo\nconst fecha = parseFecha(ai.fechaNovedad) || parseFecha(ai.fechaIngreso)\n           || parseFecha(ai.fechaDocumento) || parseFecha(j.fechaCorreo) || 'SIN-FECHA';\n\nconst entidad = (ai.entidad || '').toString().toUpperCase().trim();\nconst nombreArchivo = `AFIL ${tipo} ${fecha}.pdf`;\n\nreturn [{\n  json: { ...j, cedula, nombre: nombreNorm, entidad, tipo, fecha, nombreArchivo,\n          datosOk: Boolean(cedula || nombreNorm) },\n  binary: orig.binary,\n}];"
      }
    },
    {
      "id": "http_search_ced",
      "name": "🔍 Dropbox search (cédula+nombre)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        360
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/files/search_v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "dropboxOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: ($json.cedula || $json.nombre || ' '), options: { path: $('⚙️ Configuración').item.json.dropboxRoot, max_results: 50, file_status: 'active', filename_only: false } }) }}",
        "options": {}
      },
      "credentials": {
        "dropboxOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Dropbox Root"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 4000
    },
    {
      "id": "code_eval",
      "name": "🗂️ Resolver carpeta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        360
      ],
      "parameters": {
        "jsCode": "// Evalúa la respuesta de Dropbox search_v2 (en $json) contra la cédula/nombre del item consolidado.\nconst resp = $json || {};\nconst prev = $('🧮 Consolidar datos').item.json;\nconst root = ($('⚙️ Configuración').item.json.dropboxRoot || '').toLowerCase();\nconst ced = prev.cedula || '';\nconst nombre = (prev.nombre || '').toLowerCase();\n\nconst matches = resp.matches || [];\nconst folders = [];\nfor (const m of matches) {\n  const md = (m && m.metadata && m.metadata.metadata) || (m && m.metadata) || {};\n  const tag = md['.tag'] || md.tag;\n  if (tag !== 'folder') continue;\n  const path = md.path_display || md.path_lower || '';\n  if (root && !path.toLowerCase().includes(root)) continue;\n  folders.push(path);\n}\n\nconst norm = s => (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();\nlet hits = ced ? folders.filter(p => p.replace(/\\D/g, '').includes(ced)) : [];\nlet foundBy = 'cedula';\nif (hits.length === 0 && nombre) {\n  hits = folders.filter(p => norm(p).includes(norm(nombre)));\n  foundBy = 'nombre';\n}\n\nlet resolved = 'NONE', folderPath = '';\nif (hits.length === 1) { resolved = 'FOUND'; folderPath = hits[0]; }\nelse if (hits.length > 1) { resolved = 'MULTIPLE'; folderPath = hits.join(' | '); }\n\nreturn [{\n  json: { ...prev, resolved, folderPath, foundBy: resolved === 'FOUND' ? foundBy : '',\n          candidatos: folders.length },\n  binary: $('🧮 Consolidar datos').item.binary,\n}];"
      }
    },
    {
      "id": "switch_res",
      "name": "↔️ Resultado",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1380,
