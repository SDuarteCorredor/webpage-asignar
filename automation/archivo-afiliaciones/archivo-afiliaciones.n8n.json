    {
      "id": "code_dest",
      "name": "🗂️ Definir carpeta y nombre",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        320
      ],
      "parameters": {
        "jsCode": "// Recibe (input combinado) el item con binario + el resultado de búsqueda de Dropbox.\n// Elige la carpeta del colaborador y arma la ruta destino dentro de la subcarpeta AFILIACIONES.\nconst j = $json;\nconst cedula = j.cedula;\nconst matches = j.matches || j.results || [];\nlet folderPath = '';\nfor (const m of matches) {\n  const md = (m && m.metadata && m.metadata.metadata) || (m && m.metadata) || m;\n  const tag = md['.tag'] || md.tag;\n  if (tag === 'folder') {\n    const path = md.path_lower || md.path_display || '';\n    if (path && path.replace(/\\D/g, '').includes(cedula)) { folderPath = md.path_display || path; break; }\n    if (!folderPath) folderPath = md.path_display || path; // primer folder como respaldo\n  }\n}\nconst encontrada = Boolean(folderPath);\n// Fecha legible dd-mm-aaaa\nlet f = (j.fechaIngreso || j.fechaCorreo || '').toString();\nlet fecha = 'SIN-FECHA';\nconst d = new Date(f);\nif (!isNaN(d.getTime())) {\n  const dd = String(d.getDate()).padStart(2, '0');\n  const mm = String(d.getMonth() + 1).padStart(2, '0');\n  fecha = `${dd}-${mm}-${d.getFullYear()}`;\n} else if (f) {\n  fecha = f.replace(/[\\/]/g, '-');\n}\nconst entidad = (j.entidad || '').trim();\nconst tipo = (j.tipo || 'EPS').trim();\nconst nombreArchivo = `${cedula} ${entidad} ${tipo} ${fecha}.pdf`.replace(/\\s+/g, ' ').trim();\nconst destino = encontrada ? `${folderPath}/AFILIACIONES/${nombreArchivo}` : '';\nreturn [{\n  json: { ...j, encontrada, folderPath, nombreArchivo, destino,\n          estado: encontrada ? 'ARCHIVADO' : 'NO ENCONTRADA', fechaArchivo: fecha },\n  binary: $input.item.binary,\n}];"
      }
    },
