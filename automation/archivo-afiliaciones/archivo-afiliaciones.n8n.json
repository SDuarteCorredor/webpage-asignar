    {
      "id": "code_split",
      "name": "🧩 Normalizar y separar PDFs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -620,
        300
      ],
      "parameters": {
        "jsCode": "// Toma los correos de Gmail (con adjuntos descargados) y emite UN item por cada PDF.\n// Extracción determinista: cédula = primer bloque largo de dígitos del nombre del archivo.\nconst out = [];\nfor (const item of $input.all()) {\n  const binary = item.binary || {};\n  const j = item.json || {};\n  const fechaCorreo = j.date || j.internalDate || j.Date || '';\n  let remitente = '';\n  if (j.from && typeof j.from === 'object') {\n    remitente = j.from.text || (j.from.value && j.from.value[0] && j.from.value[0].address) || '';\n  } else {\n    remitente = j.from || j.From || '';\n  }\n  for (const key of Object.keys(binary)) {\n    const b = binary[key];\n    const name = (b.fileName || '').trim();\n    if (!/\\.pdf$/i.test(name)) continue;\n    const base = name.replace(/\\.pdf$/i, '').trim();\n    const ced = (base.match(/\\d{6,}/) || [''])[0];\n    const resto = base.replace(ced, '').replace(/[-_]+/g, ' ').trim();\n    const entidad = resto.toUpperCase();\n    let tipo = 'EPS';\n    if (/CAJA|COMFA|COMPENSAR|COLSUBSIDIO|CAFAM|COMPENSACI|COMFENALCO|COMFANDI/i.test(entidad)) tipo = 'CAJA';\n    out.push({\n      json: {\n        cedula: ced,\n        entidadRaw: resto,\n        entidad: entidad,\n        tipo: tipo,\n        fechaCorreo: fechaCorreo,\n        fechaIngreso: '',\n        remitente: remitente,\n        fileName: name,\n        datosCompletos: Boolean(ced && entidad),\n      },\n      binary: { data: b },\n    });\n  }\n}\nreturn out;"
      }
    },
