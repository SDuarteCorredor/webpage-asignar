    {
      "parameters": {
        "jsCode": "// Resuelve a qué reclutador enrutar la postulación.\n//\n// El sitio NO envía el correo del reclutador: manda solo el vacanteId y aquí\n// se busca en el Sheet. vacanteId = 1 corresponde a la primera fila de datos\n// (fila 2 del Sheet, porque la 1 son encabezados).\n\nconst wh = $('📥 Postulación (webhook)').first().json;\nconst body = wh.body || {};\nconst cfg = $('⚙️ Configuración').first().json || {};\nconst filas = $('📋 Leer vacantes').all().map(i => i.json);\n\nconst idx = parseInt(body.vacanteId, 10);\nconst fila = (!isNaN(idx) && idx > 0) ? (filas[idx - 1] || {}) : {};\n\nconst limpio = v => String(v ?? '').trim();\n\n// Si la fila no trae correo (o el id no cuadró), va al buzón de revisión.\nconst reclutador = limpio(fila.correo_reclutador) || cfg.correoFallback;\nconst enrutadoOk = Boolean(limpio(fila.correo_reclutador));\n\n// Preferimos los datos del Sheet; si algo falta, usamos lo que mandó el sitio.\nconst cargo  = limpio(fila.cargo)  || limpio(body.cargo)  || '(sin cargo)';\nconst ciudad = limpio(fila.ciudad) || limpio(body.ciudad) || '(sin ciudad)';\nconst sector = limpio(fila.sector) || limpio(body.sector) || '';\n\nconst autorizaMarketing = limpio(body.autorizaMarketing).toLowerCase() === 'true';\n\n// ¿Vino hoja de vida? El webhook deja los archivos en binary.\nconst binarios = Object.keys($('📥 Postulación (webhook)').first().binary || {});\nconst propArchivo = binarios[0] || '';\nconst tieneHV = binarios.length > 0;\n\nconst nombre = limpio(body.nombre);\nconst documento = `${limpio(body.tipoDocumento) || 'CC'} ${limpio(body.documento)}`.trim();\n\nconst asunto = `[POSTULACIÓN WEB] ${ciudad} | ${cargo} - ${nombre}`;\n\nconst mensaje = [\n  'Nueva postulación recibida desde la página web.',\n  '',\n  `Cargo: ${cargo}`,\n  `Ciudad: ${ciudad}`,\n  sector ? `Sector: ${sector}` : '',\n  '',\n  '--- Datos del candidato ---',\n  `Nombre: ${nombre}`,\n  `Documento: ${documento}`,\n  `Edad: ${limpio(body.edad)}`,\n  `Teléfono: ${limpio(body.telefono)}`,\n  `WhatsApp: ${limpio(body.whatsapp) || '—'}`,\n  `Hoja de vida: ${tieneHV ? 'adjunta a este correo' : 'no adjuntó'}`,\n  '',\n  'Autoriza tratamiento de datos (Ley 1581): sí',\n  `Autoriza comunicaciones comerciales: ${autorizaMarketing ? 'sí' : 'no'}`,\n  enrutadoOk ? '' : '\\n⚠️ No se pudo identificar la vacante en el Sheet: revisar y reenviar al equipo que corresponda.',\n].filter(Boolean).join('\\n');\n\nreturn [{\n  json: {\n    vacanteId: limpio(body.vacanteId),\n    reclutador,\n    enrutadoOk,\n    cargo, ciudad, sector,\n    nombre, documento,\n    edad: limpio(body.edad),\n    telefono: limpio(body.telefono),\n    whatsapp: limpio(body.whatsapp),\n    autorizaMarketing,\n    tieneHV,\n    propArchivo,\n    nombreArchivo: tieneHV\n      ? `${ciudad} - ${cargo} - ${nombre}`.replace(/[\\\\/:*?\"<>|]/g, '-')\n      : '',\n    asunto,\n    mensaje,\n    fecha: new Date().toISOString(),\n    carpetaDriveHV: cfg.carpetaDriveHV,\n    correoCopia: cfg.correoCopia,\n  },\n  binary: $('📥 Postulación (webhook)').first().binary || {},\n}];"
      },
