      "parameters": {
        "jsCode": "// Arma la fila tal como la espera la hoja `Vacantes`.\n//\n// El reclutador no escribe departamento ni correo de selección: se deducen de\n// la ciudad. Así no hay forma de que queden inconsistentes con el resto de la\n// hoja, que es de donde el portal saca los filtros.\n\nconst f = $input.first().json;\nconst limpio = (v) => String(v ?? '').trim();\n\nconst EQUIPOS = {\n  'Medellín':     ['Antioquia',       'seleccion4@asignar.com.co'],\n  'Bogotá':       ['Cundinamarca',    'reclutamientobog4@asignar.com.co'],\n  'Cali':         ['Valle del Cauca', 'seleccioncali@asignar.com.co'],\n  'Cartagena':    ['Bolívar',         'seleccioncartagena407@gmail.com'],\n  'Barranquilla': ['Atlántico',       'seleccionbarranquilla@asignar.com.co'],\n  'Rionegro':     ['Antioquia',       'seleccion4@asignar.com.co'],\n};\n\nconst elegida = limpio(f['Ciudad']);\nconst esOtra = elegida.startsWith('Otra');\n\n// Con una ciudad nueva no hay a quién enrutar: se usa el buzón de respaldo y\n// queda registrado, en vez de dejar la celda vacía y romper la postulación.\nconst RESPALDO = 'contratacion2@asignar.com.co';\n\nconst ciudad = esOtra ? (limpio(f['Otra ciudad']) || 'Sin definir') : elegida;\nconst departamento = esOtra\n  ? limpio(f['Otro departamento'])\n  : (EQUIPOS[elegida]?.[0] ?? '');\nconst reclutador = esOtra\n  ? (limpio(f['Correo del equipo de selección']) || RESPALDO)\n  : (EQUIPOS[elegida]?.[1] ?? RESPALDO);\n\n// El portal muestra el salario tal como esté escrito en la celda, así que se\n// formatea acá una sola vez en lugar de confiar en cómo lo escriba cada quien.\nconst monto = Number(String(f['Salario mensual']).replace(/[^\\d]/g, ''));\nconst salario = monto > 0\n  ? '$' + monto.toLocaleString('es-CO')\n  : limpio(f['Salario mensual']);\n\nconst DETALLE_ESTANDAR = '+ Auxilio de transporte · + Prestaciones de ley';\n\nreturn [{\n  json: {\n    activa: 'SI',                       // toda vacante nueva nace publicada\n    cargo: limpio(f['Cargo']),\n    ciudad,\n    departamento,\n    sector: limpio(f['Sector']),\n    contrato: limpio(f['Tipo de contrato']),\n    salario,\n    salario_detalle: limpio(f['Detalle del salario']) || DETALLE_ESTANDAR,\n    experiencia: limpio(f['Experiencia']),\n    jornada: limpio(f['Jornada']),\n    modalidad: limpio(f['Modalidad']),\n    funciones: limpio(f['Funciones principales']),\n    destacada: limpio(f['¿Destacada en el portal?']) === 'Sí' ? 'SI' : '',\n    correo_reclutador: reclutador,\n  },\n}];\n"
      },
